<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}GetTested{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1c252e;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;padding:24px 12px;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;">
                <tr>
                    <td style="background:#00a76f;padding:20px 32px;">
                        <span style="font-size:22px;font-weight:bold;color:#ffffff;">Get<span style="color:#c8fad6;">Tested</span></span>
                    </td>
                </tr>
                <tr>
                    <td style="padding:32px;font-size:15px;line-height:1.6;">
                        <p style="margin:0 0 16px 0;">Bonjour {{ firstname }},</p>

                        {% block content %}{% endblock %}

                        {% block session %}
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0;background:#f9fafb;border:1px solid #e5e8eb;border-radius:8px;">
                                <tr>
                                    <td style="padding:16px 20px;font-size:14px;">
                                        <p style="margin:0 0 4px 0;font-size:16px;font-weight:bold;">{{ session.title }}</p>
                                        <p style="margin:0;color:#637381;">
                                            {{ session.institute }}
                                            {% if session.start %} · {{ session.start|date('d/m/Y') }}{% endif %}
                                            {% if referenceNumber %}<br>Dossier n° {{ referenceNumber }}{% endif %}
                                        </p>
                                        {% if exams is not empty %}
                                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:12px;font-size:13px;">
                                                {% for exam in exams %}
                                                    <tr>
                                                        <td style="padding:6px 0;border-top:1px dashed #dfe3e8;">
                                                            <strong>{{ exam.label }}</strong>
                                                            {% if exam.start %}<br><span style="color:#637381;">{{ exam.start|date('d/m/Y à H:i') }}</span>{% endif %}
                                                            {% if exam.place %}<br><span style="color:#637381;">{{ exam.place }}</span>{% endif %}
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </table>
                                        {% endif %}
                                    </td>
                                </tr>
                            </table>
                        {% endblock %}

                        {% if enrollmentUrl %}
                            <p style="margin:24px 0;text-align:center;">
                                <a href="{{ enrollmentUrl }}" style="display:inline-block;background:#1c252e;color:#ffffff;text-decoration:none;font-weight:bold;padding:12px 24px;border-radius:8px;">
                                    {% block cta %}Voir mon inscription{% endblock %}
                                </a>
                            </p>
                        {% endif %}

                        <p style="margin:24px 0 0 0;color:#637381;font-size:13px;">
                            Une question sur votre session ? Contactez {{ session.institute ?: 'l\'institut' }}{% if session.instituteEmail %} à <a href="mailto:{{ session.instituteEmail }}" style="color:#00a76f;">{{ session.instituteEmail }}</a>{% endif %}.
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 32px;background:#f9fafb;color:#919eab;font-size:12px;">
                        Cet email vous est envoyé par GetTested dans le cadre de votre inscription. Merci de ne pas y répondre directement.
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
