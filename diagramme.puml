' SYSTÈME DE QUESTIONS, SUJETS & TESTING ADAPTATIF
' ─────────────────────────────────────────────────

enum "QuestionStatusEnum" {
    DRAFT
    PRETESTING
    CALIBRATED
    RETIRED
}

enum "SubjectStatusEnum" {
    DRAFT
    LOCKED
    ARCHIVED
}

enum "SubjectModeEnum" {
    FIXED
    GENERATED
}

enum "PracticeSessionStatusEnum" {
    IN_PROGRESS
    COMPLETED
    ABANDONED
}

