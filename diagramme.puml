    CORRECT
    INCORRECT
    PARTIAL
    SKIPPED
}

' ─────── ITEM BANK (Banque de questions) ───────

abstract class Question <<Entity>> {
    -id: int
    -label: string
    -text: string
    -instruction: string
    -duration: int
    -maxPoints: float
    -status: QuestionStatusEnum
    ' ── Paramètres IRT (Item Response Theory) ──
    ' Null tant que status != CALIBRATED
    -irtDifficulty: float           ' param b : [-3.0 … +3.0]
    -irtDiscrimination: float       ' param a : [0.3 … 2.5]
    -irtGuessing: float             ' param c : [0.0 … 0.5] (QCM)
    -irtStdError: float             ' erreur standard des estimations
    ' ── Statistiques de calibration ──
    -timesAdministered: int         ' nb total de passages
    -successRate: float             ' taux brut de réussite
    -avgResponseTimeMs: int         ' temps moyen de réponse
    ' ── Gestion du cycle de vie ──
    -isSeedItem: bool               ' utilisable en pretest (ne compte pas)
    -retiredAt: datetime
    -retiredReason: string
    -createdAt: datetime
    -updatedAt: datetime
}

class MCQQuestion {
    -isMultipleAnswer: bool
    -shuffleChoices: bool
}

class FillBlankQuestion {
    -blankSymbol: string
}

class HighlightQuestion {
    ' zones définies par HighlightZone
}

class OrderingQuestion {
    -shuffleOnDisplay: bool
}

class MatchingQuestion {
    -shuffleOnDisplay: bool
}

' ─────── ÉLÉMENTS DE RÉPONSE ───────

class Choice {
    -text: string
    -weight: float              ' 1.0=correct, 0.5=partiel, 0.0=faux, <0=pénalité
    -position: int
    -feedback: string           ' explication post-réponse
}

class BlankSlot {
    -position: int              ' n° du blanc dans le texte
    -acceptedAnswers: json      ' ["Paris","paris","PARIS"]
    -caseSensitive: bool
    -accentSensitive: bool
}

class HighlightZone {
    -startIndex: int
    -endIndex: int
    -isCorrect: bool
}

class OrderingItem {
    -text: string
    -correctPosition: int
}

class MatchingPair {
    -leftText: string
    -rightText: string
    -position: int
}

class Media {
    -type: enum {IMAGE, AUDIO, VIDEO, YOUTUBE}
    -url: string
    -description: string
    -position: int
}

' ─────── SUBJECT (Sujet d'examen — unique, figé) ───────

class Subject <<Entity>> {
    -titre: string
    -description: string
    -status: SubjectStatusEnum
    -mode: SubjectModeEnum
    -lockedAt: datetime
    -lockedBy: User
    -passingScore: float
    -totalMaxPoints: float
    -createdAt: datetime
}

class SubjectQuestion {
    -position: int
    -isSeed: bool               ' question de pretest (ne compte pas dans le score)
    -pointsOverride: float      ' surcharge du maxPoints pour ce sujet (null = défaut)
}

' ─────── COMPOSITION RULES (règles pour générer un sujet) ───────

class SubjectCompositionRule <<ValueObject>> {
    -totalQuestions: int
    -totalSeedQuestions: int
    -durationMinutes: int
    -skillDistribution: json           ' {"compréhension": 40, "grammaire": 30, "vocabulaire": 30}
    -difficultyDistribution: json      ' {"easy": 30, "medium": 50, "hard": 20}
    -minSpacingDaysGlobal: int         ' espacement min entre 2 usages d'une question
    -minSpacingDaysSameInstitute: int  ' espacement par centre (plus strict)
    -maxExposureRate: float            ' % max de candidats voyant une question (ex: 0.35)
}

' ─────── CANDIDATE RESPONSE (traçabilité) ───────

class CandidateResponse {
    -givenAnswer: json           ' réponse brute (flexible selon le type)
    -status: CandidateResponseStatusEnum
    -score: float
    -responseTimeMs: int
    -answeredAt: datetime
    ' ── Contexte adaptatif (nullable) ──
    -thetaAtAnswer: float        ' estimation θ du candidat au moment de la réponse
    -informationValue: float     ' Fisher information apportée par cet item
}

' ─────── PRACTICE SESSION (entraînement adaptatif) ───────

class PracticeSession {
    -status: PracticeSessionStatusEnum
    -startedAt: datetime
    -finishedAt: datetime
    -totalQuestions: int
    -questionsAnswered: int
    ' ── Estimation IRT ──
    -initialTheta: float         ' θ de départ (prior ou dernière estimation connue)
    -finalTheta: float           ' θ final estimé
    -finalStdError: float        ' précision de l'estimation
    -estimatedLevel: string      ' mapping θ → Level (ex: "B1")
    ' ── Diagnostic par compétence ──
    -skillScores: json           ' {"compréhension": 0.72, "grammaire": 0.45, ...}
    ' ── Config ──
    -maxQuestions: int            ' limite max
    -stoppingSeThreshold: float   ' arrêt quand SE < seuil (ex: 0.3)
}

' ─────── ABILITY ESTIMATE (suivi longitudinal du niveau) ───────

class AbilityEstimate {
    -theta: float                ' estimation du niveau
    -stdError: float             ' précision
    -estimatedLevel: string      ' mapping → Level label
    -source: enum {EXAM, PRACTICE, CALIBRATION}
    -estimatedAt: datetime
    -skillBreakdown: json        ' détail par compétence
}

